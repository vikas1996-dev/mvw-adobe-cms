<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Page"
    sling:resourceType="cq/gui/components/authoring/dialog"
    extraClientlibs="[cq.common.wcm,core.wcm.components.page.v3.editor,cq.wcm.msm.properties,granite.contexthub.configuration,cq.siteadmin.admin.properties,core.wcm.components.image.v3.editor]"
    helpPath="https://www.adobe.com/go/aem_cmp_page_v3"
    mode="edit"
    trackingFeature="core-components:page:v3">
    <content
        granite:class="cq-dialog-content-page"
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                granite:class="cq-siteadmin-admin-properties-tabs"
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                size="L">
                <items jcr:primaryType="nt:unstructured">
                    <basic
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Basic"
                        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                        <items jcr:primaryType="nt:unstructured">
                            <column
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                <items jcr:primaryType="nt:unstructured">
                                    <hideFromHtmlSitemap
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                        checked="{Boolean}false"
                                        sling:orderBefore="branding"
                                        fieldDescription="When checked, will hide this page from HTML Sitemap."
                                        name="./hideFromHtmlSitemap"
                                        text="Hide from HTML Sitemap"
                                        uncheckedValue="false"
                                        value="{Boolean}true"/>
                                    <thirdPartyLink
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                        checked="{Boolean}false"
                                        sling:orderBefore="branding"
                                        fieldDescription="When checked, opens the link to this page, from the site's navigation, in a new tab."
                                        name="./thirdPartyLink"
                                        text="Open in new tab"
                                        uncheckedValue="false"
                                        value="{Boolean}true"/>
                                    <analytics
                                        cq:showOnCreate="{Boolean}true"
                                        jcr:primaryType="nt:unstructured"
                                        jcr:title="Analytics"
                                        sling:orderBefore="branding"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">
                                        <items jcr:primaryType="nt:unstructured">
                                            <siteSection
                                                jcr:primaryType="nt:unstructured"
                                                sling:orderBefore="branding"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="Site Section"
                                                name="./siteSection">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <home
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Home"
                                                        value="Home"/>
                                                    <experiences
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Experiences"
                                                        value="Experiences"/>
                                                    <ownership
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Ownership"
                                                        value="Ownership"/>
                                                    <specialOffers
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Special Offers"
                                                        value="Special Offers"/>
                                                    <landingPages
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Landing Pages"
                                                        value="Landing Pages"/>
                                                    <legalAndDisclosures
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Legal and Disclosures "
                                                        value="Legal and Disclosures "/>
                                                    <contactUs
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Contact Us"
                                                        value="Contact Us"/>
                                                    <errorPages
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Error Pages"
                                                        value="Error Pages"/>
                                                    <forOwnership
                                                        jcr:primaryType="nt:unstructured"
                                                        text="For Ownership"
                                                        value="For Ownership"/>
                                                    <requestInformation
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Request Information"
                                                        value="Request Information"/>
                                                    <faq
                                                        jcr:primaryType="nt:unstructured"
                                                        text="FAQ"
                                                        value="FAQ"/>
                                                    <exitOwnership
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Exit Ownership"
                                                        value="Exit Ownership"/>
                                                    <resorts
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Resorts"
                                                        value="Resorts"/>
                                                    <siteMap
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Site Map"
                                                        value="Site Map"/>
                                                </items>
                                            </siteSection>
                                        </items>
                                    </analytics>
                                </items>
                            </column>
                        </items>
                    </basic>
                    <thumbnail
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Images"
                        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                        <items jcr:primaryType="nt:unstructured">
                            <column
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                <items jcr:primaryType="nt:unstructured">
                                    <twitterimage
                                        granite:class="cmp-image__editor"
                                        jcr:primaryType="nt:unstructured"
                                        jcr:title="Twitter Card"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">
                                        <items jcr:primaryType="nt:unstructured">
                                            <file
                                                granite:class="cmp-image__editor-file-upload"
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                                allowDrop="{Boolean}false"
                                                allowUpload="{Boolean}true"
                                                class="cq-droptarget"
                                                fieldDescription="Used in components referencing the page (e.g. teaser, list of pages)"
                                                fieldLabel="Image"
                                                fileNameParameter="./cq:twitterimage/fileName"
                                                fileReferenceParameter="./cq:twitterimage/fileReference"
                                                mimeTypes="[image/gif,image/jpeg,image/png,image/tiff,image/svg+xml]"
                                                name="./cq:twitterimage/file">
                                                <granite:data
                                                    jcr:primaryType="nt:unstructured"
                                                    cq-msm-lockable="/cq:twitterimage"/>
                                            </file>
                                            <type
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/hidden"
                                                name="./cq:twitterimage/sling:resourceType"
                                                value="core/wcm/components/image/v3/image"/>
                                            <alternativeGroup
                                                granite:class="cmp-image__editor-alt"
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/well">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <alt
                                                        granite:class="cmp-image__editor-alt-text"
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                        fieldDescription="Textual alternative of the meaning or function of the image, for visually impaired readers."
                                                        fieldLabel="Alternative Text"
                                                        name="./cq:twitterimage/alt">
                                                        <granite:data
                                                            jcr:primaryType="nt:unstructured"
                                                            cq-msm-lockable="/cq:twitterimage"/>
                                                    </alt>
                                                    <altValueFromDAM
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                        checked="true"
                                                        fieldDescription="When checked, populate the image's alt attribute with the value of the dc:description metadata in DAM."
                                                        name="./cq:twitterimage/altValueFromDAM"
                                                        text="Inherit - Value taken from the DAM asset"
                                                        uncheckedValue="false"
                                                        value="{Boolean}true">
                                                        <granite:data
                                                            jcr:primaryType="nt:unstructured"
                                                            cq-msm-lockable="/cq:twitterimage"/>
                                                    </altValueFromDAM>
                                                </items>
                                            </alternativeGroup>
                                        </items>
                                    </twitterimage>
                                </items>
                            </column>
                        </items>
                    </thumbnail>
                    <json-ld-schema
                        jcr:primaryType="nt:unstructured"
                        jcr:title="JSON-LD Schema"
                        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                        <items jcr:primaryType="nt:unstructured">
                            <column
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                <items jcr:primaryType="nt:unstructured">
                                    <jsonSchemaLd
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                        columns="150"
                                        fieldLabel="Json LD Schema Json"
                                        name="./jsonSchema"
                                        rows="100"/>
                                </items>
                            </column>
                        </items>
                    </json-ld-schema>
                    <errorpageconfigurations
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Error Page Configuration"
                        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                        <items jcr:primaryType="nt:unstructured">
                            <column
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                <items jcr:primaryType="nt:unstructured">
                                    <errorPages
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Error Pages"
                                        name="./errorPages"
                                        rootPath="/content/tmvcs"
                                        renderReadOnly="{Boolean}true" />
                                </items>
                            </column>
                        </items>
                    </errorpageconfigurations>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
