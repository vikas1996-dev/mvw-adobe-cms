<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Button"
    sling:resourceType="cq/gui/components/authoring/dialog"
    extraClientlibs="[core.wcm.components.button.v2.editor]"
    helpPath="https://www.adobe.com/go/aem_cmp_button_v2"
    trackingFeature="core-components:button:v2">
    <content
        granite:class="cmp-button__editor"
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <properties
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Properties"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <ctaSize
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/foundation/form/select"
                                                fieldLabel="CTA Size"
                                                name="./ctaSize">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <Large
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Large"
                                                        value="large"/>
                                                    <Medium
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Medium"
                                                        value="medium"/>
                                                    <small
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Small"
                                                        value="small"/>
                                                </items>
                                            </ctaSize>
                                            <ctaStyle
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="CTA Style"
                                                name="./ctaStyle">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <primaryButton
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Primary Button"
                                                        value="primary"/>
                                                    <primaryAltButton
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Primary Alt Button"
                                                        value="primary-alt-button"/>
                                                    <secondaryOutline
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Secondary Outline"
                                                        value="secondary-outline"/>
                                                    <secondaryButton
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Secondary Button"
                                                        value="secondary"/>
                                                    <secondaryGhost
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Secondary Ghost"
                                                        value="secondary-ghost"/>
                                                    <tertiaryButton
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Tertiary Button"
                                                        value="tertiary"/>
                                                    <specialText
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Special Text"
                                                        value="special-text"/>
                                                </items>
                                            </ctaStyle>
                                            <ctaAlignment
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                fieldLabel="CTA  Alignment"
                                                name="./ctaAlignment">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <none
                                                        jcr:primaryType="nt:unstructured"
                                                        text="None"
                                                        value="none"/>
                                                    <leftIcon
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Left Icon"
                                                        value="left-icon"/>
                                                    <rightIcon
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Right Icon"
                                                        value="right-icon"/>
                                                    <tonal
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Tonal"
                                                        value="tonal"/>
                                                    <iconOnly
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Icon Only"
                                                        value="icon-only"/>
                                                    <label
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Label"
                                                        value="label"/>
                                                    <copperUnderline
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Copper Underline"
                                                        value="copper-underline"/>
                                                </items>
                                            </ctaAlignment>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </properties>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
