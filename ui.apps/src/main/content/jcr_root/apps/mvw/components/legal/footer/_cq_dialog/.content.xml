<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0"
    xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Properties"
    sling:resourceType="cq/gui/components/authoring/dialog"
             extraClientlibs="[mvw.cta.container.authoring]">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <logoimage
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Logo Image"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <logoImage
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                                allowUpload="false"
                                                class="cq-droptarget"
                                                enableNextGenDynamicMedia="{Boolean}true"
                                                fieldDescription="Upload the Main logo to be displayed in the footer"
                                                fieldLabel="Main Logo Image"
                                                fileNameParameter="./fileName"
                                                fileReferenceParameter="./logoImage"
                                                mimeTypes="[image/gif,image/jpeg,image/png,image/tiff,image/svg+xml,image/webp]"
                                                name="./logoImages" />
                                            <altText
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldDescription="Enter the Alt Text for the logo image."
                                                fieldLabel="Alt Text"
                                                name="./logoImageAltText" />
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </logoimage>
                    <brandImages
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Brand Logos"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        granite:class="cq-RichText-FixedColumn-column"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <navigationlink
                                                jcr:primaryType="nt:unstructured"
                                                jcr:title="Brand Images"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                composite="{Boolean}true"
                                                fieldLabel="Brand Images">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    jcr:title="Brand Images"
                                                    sling:resourceType="granite/ui/components/foundation/container"
                                                    name="./brandDetails">
                                                    <layout
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/foundation/layouts/collapsible" />
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <brandImage
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                                            allowUpload="false"
                                                            class="cq-droptarget"
                                                            enableNextGenDynamicMedia="{Boolean}true"
                                                            fieldDescription="configure the brand image here"
                                                            fieldLabel="Brand Image"
                                                            fileNameParameter="./fileName"
                                                            fileReferenceParameter="./brandImage"
                                                            mimeTypes="[image/gif,image/jpeg,image/png,image/tiff,image/svg+xml]"
                                                            name="./brandImages"
                                                            required="{Boolean}true" />
                                                        <altText
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldDescription="Enter the Alt Text for the image."
                                                            fieldLabel="Alt Text"
                                                            name="./brandImageAltText" />
                                                        <linkURL
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathbrowser"
                                                            fieldDescription="Select the link URL for the brand image"
                                                            fieldLabel="Link URL"
                                                            name="./brandImageLink" />
                                                        <target
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                            fieldDescription="Select how the link should open, either in the same tab or a new tab"
                                                            fieldLabel="Link Opens In"
                                                            name="./brandImageLinkTarget"
                                                            value="_self">
                                                            <items jcr:primaryType="nt:unstructured">
                                                                <new-tab
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="New Tab"
                                                                    value="_blank" />
                                                                <same-tab
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Same Tab"
                                                                    value="_self" />
                                                            </items>
                                                        </target>
                                                        <ariaLabel
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldLabel="Logo Aria Label"
                                                            name="./ariaLabel"
                                                            required="{Boolean}true" />
                                                    </items>
                                                </field>
                                                <granite:data
                                                    jcr:primaryType="nt:unstructured"
                                                    max-items="{Long}5"
                                                    min-items="{Long}1" />
                                            </navigationlink>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </brandImages>
                    <legalcopies
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Footer Copies"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        granite:class="cq-RichText-FixedColumn-column"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <footerCopy
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                                                fieldDescription="Footer copy text"
                                                fieldLabel="Footer Copy Text"
                                                name="./footerText"
                                                required="{Boolean}true"
                                                useFixedInlineToolbar="{Boolean}true">
                                                <rtePlugins
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceSuperType="/apps/mvw/components/legal/richtext_block/cq:dialog/content/items/richtext/rtePlugins" />
                                                <uiSettings
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceSuperType="/apps/mvw/components/legal/richtext_block/cq:dialog/content/items/richtext/uiSettings" />
                                            </footerCopy>
                                            <equalHousing
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                                allowUpload="false"
                                                class="cq-droptarget"
                                                fieldDescription="Equal Housing Image "
                                                fieldLabel="Equal Housing Image "
                                                fileNameParameter="./equalImage/fileName"
                                                fileReferenceParameter="./equalImage/fileReference"
                                                mimeTypes="[image/gif,image/jpeg,image/png,image/tiff,image/svg+xml,image/webp]"
                                                name="./equalImage/file"
                                                useHTML5="true" />
                                            <legalCopy
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                                                fieldDescription="Legal copy text"
                                                fieldLabel="Legal Copy Text"
                                                name="./legalText"
                                                required="{Boolean}true"
                                                useFixedInlineToolbar="{Boolean}true">
                                                <rtePlugins
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceSuperType="/apps/mvw/components/legal/richtext_block/cq:dialog/content/items/richtext/rtePlugins" />
                                                <uiSettings
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceSuperType="/apps/mvw/components/legal/richtext_block/cq:dialog/content/items/richtext/uiSettings" />
                                            </legalCopy>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </legalcopies>
                    <legalLinks
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Legal Links"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <legalLinks
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                composite="{Boolean}true"
                                                fieldDescription="Add legal links here"
                                                fieldLabel="Legal Links">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                                    name="./legalLinks">
                                                    <items
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">
                                                        <layout
                                                            jcr:primaryType="nt:unstructured"
                                                            jcr:title="Legal link"
                                                            sling:resourceType="granite/ui/components/foundation/layouts/collapsible"
                                                            collapsed="{Boolean}true">
                                                            <items jcr:primaryType="nt:unstructured">
                                                                <well
                                                                    jcr:primaryType="nt:unstructured"
                                                                    sling:resourceType="granite/ui/components/foundation/container">
                                                                    <items
                                                                        jcr:primaryType="nt:unstructured">
                                                                        <layout
                                                                            jcr:primaryType="nt:unstructured"
                                                                            sling:resourceType="granite/ui/components/foundation/layouts/well">
                                                                            <items
                                                                                jcr:primaryType="nt:unstructured">
                                                                                <cta-url
                                                                                    jcr:primaryType="nt:unstructured"
                                                                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathbrowser"
                                                                                    fieldDescription="Select the link URL for the legal link"
                                                                                    fieldLabel="CTA URL"
                                                                                    name="./legalLinkUrl"
                                                                                    required="{Boolean}true" />
                                                                                <ctaText
                                                                                    jcr:primaryType="nt:unstructured"
                                                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                                    fieldDescription="Enter the CTA Text"
                                                                                    fieldLabel="CTA Text"
                                                                                    name="./legalLinkText"
                                                                                    required="{Boolean}true" />
                                                                                <cta-opens
                                                                                    jcr:primaryType="nt:unstructured"
                                                                                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                                                    checked="false"
                                                                                    fieldDescription="Select the CTA Opens in same tab or new tab"
                                                                                    fieldLabel="CTA Opens In"
                                                                                    name="./legalLinkTab"
                                                                                    value="true">
                                                                                    <items
                                                                                        jcr:primaryType="nt:unstructured">
                                                                                        <new-tab
                                                                                            jcr:primaryType="nt:unstructured"
                                                                                            text="New Tab"
                                                                                            value="_blank" />
                                                                                        <same-tab
                                                                                            jcr:primaryType="nt:unstructured"
                                                                                            text="Same Tab"
                                                                                            value="_self" />
                                                                                    </items>
                                                                                </cta-opens>
                                                                                <thirdParty
                                                                                    jcr:primaryType="nt:unstructured"
                                                                                    sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                                                    fieldDescription="Check if the link is to a third party website."
                                                                                    name="./thirdParty"
                                                                                    text="Is Third Party?"
                                                                                    uncheckedValue="false"
                                                                                    value="{Boolean}true" />
                                                                                <iscookielink
                                                                                    jcr:primaryType="nt:unstructured"
                                                                                    sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                                                    checked="false"
                                                                                    fieldDescription="Check if this link is a cookie Consent."
                                                                                    name="./cookieLink"
                                                                                    text="Is Cookie Link"
                                                                                    value="true" />
                                                                            </items>
                                                                        </layout>
                                                                    </items>
                                                                </well>
                                                            </items>
                                                        </layout>
                                                    </items>
                                                </field>
                                            </legalLinks>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </legalLinks>
                    <accessability
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Accessability"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">
                                            <cta-url
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathbrowser"
                                                fieldDescription="Select the link URL Accessability Link"
                                                fieldLabel="Accessability Url"
                                                name="./legalLinkUrl"
                                                required="{Boolean}true" />
                                            <cta-opens
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                checked="false"
                                                fieldDescription="Select the CTA Opens in same tab or new tab"
                                                fieldLabel="CTA Opens In"
                                                name="./legalLinkTab"
                                                value="true">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <new-tab
                                                        jcr:primaryType="nt:unstructured"
                                                        text="New Tab"
                                                        value="_blank" />
                                                    <same-tab
                                                        jcr:primaryType="nt:unstructured"
                                                        text="Same Tab"
                                                        value="_self" />
                                                </items>
                                            </cta-opens>
                                            <thirdParty
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                fieldDescription="Check if the link is to a third party website."
                                                name="./thirdParty"
                                                text="Is Third Party?"
                                                uncheckedValue="false"
                                                value="{Boolean}true" />
                                            <icon
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                                allowUpload="{Boolean}false"
                                                class="cq-droptarget"
                                                fieldDescription="upload Icon Image to display after the link"
                                                fieldLabel="Icon Image"
                                                fileNameParameter="./icon/fileName"
                                                fileReferenceParameter="./icon/fileReference"
                                                mimeTypes="[image/gif,image/jpeg,image/png,image/tiff,image/svg+xml]"
                                                name="./icon/file"
                                                useHTML5="true" />
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </accessability>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>