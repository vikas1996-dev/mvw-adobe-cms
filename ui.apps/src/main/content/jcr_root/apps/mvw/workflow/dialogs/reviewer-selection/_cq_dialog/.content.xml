<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <selfPeer
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/autocomplete"
                        allowBlank="{Boolean}true"
                        fieldLabel="Self/Peer"
                        multiple="{Boolean}false"
                        name="selfPeerReviewer">
                        <datasource
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/apps/mvw/components/tmvc/datasources/reviewersDatasource"
                            targetGroup="mvw-content-coordinators"/>
                        <options
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/autocomplete/list"/>
                    </selfPeer>
                    <qa
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/autocomplete"
                        allowBlank="{Boolean}true"
                        fieldLabel="QA"
                        multiple="{Boolean}false"
                        name="qaReviewer">
                        <datasource
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/apps/mvw/components/tmvc/datasources/reviewersDatasource"
                            targetGroup="mvw-qa-tmvcs"/>
                        <options
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/autocomplete/list"/>
                    </qa>
                    <copyProofread
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/autocomplete"
                        allowBlank="{Boolean}true"
                        fieldLabel="Copy/Proofread"
                        multiple="{Boolean}false"
                        name="copyProofreadReviewer">
                        <datasource
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/apps/mvw/components/tmvc/datasources/reviewersDatasource"
                            targetGroup="mvw-creatives"/>
                        <options
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/autocomplete/list"/>
                    </copyProofread>
                    <business
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/autocomplete"
                        allowBlank="{Boolean}true"
                        fieldLabel="Business"
                        multiple="{Boolean}false"
                        name="businessReviewer">
                        <datasource
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/apps/mvw/components/tmvc/datasources/reviewersDatasource"
                            targetGroup="mvw-product-owners-tmvcs"/>
                        <options
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/autocomplete/list"/>
                    </business>
                    <legal
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/autocomplete"
                        allowBlank="{Boolean}true"
                        fieldLabel="Legal"
                        multiple="{Boolean}false"
                        name="legalReviewer">
                        <datasource
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="/apps/mvw/components/tmvc/datasources/reviewersDatasource"
                            targetGroup="mvw-legal-tmvcs"/>
                        <options
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/autocomplete/list"/>
                    </legal>
                </items>
            </column>
        </items>
    </content>
</jcr:root>
