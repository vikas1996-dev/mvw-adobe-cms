#
# This file contains the filter ACL, and can be customized.
#
# By default, it includes the default filter ACL.
#

$include "./default_filters.any"

# Allow components JSON model
/0101 { /type "allow" /extension "json" /selectors "model" /path "/content/*" }

# Allow manifest.webmanifest files located in the content
/0102 { /type "allow" /extension "webmanifest" /path "/content/*/manifest" }

/0103 {/type "allow" /extension "webp"}
/0104 { /type "allow" /url "/bin/mvw/*"    }  # allow mvw servlet path access

# Allow AEM WCM Core Components sitemaps
/0105 { /type "allow" /method "GET" /path "/content/*" /selectors "(sitemap|sitemap-index)" /extension "xml" }

# Allow robots.txt or any txt file from /content/dam
/0106 { /type "allow" /method "GET" /extension "txt" /path "/content/dam/*" }

# Allow data selector JSON endpoints under content
/0107 { /type "allow" /method "GET" /extension "json" /selectors "data" /path "/content/*" }
