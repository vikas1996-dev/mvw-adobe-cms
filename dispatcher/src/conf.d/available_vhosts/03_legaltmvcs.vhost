Include conf.d/variables/custom.vars

<VirtualHost *:80>
	ServerName ${LEGALTMVC_WWW}
	ServerAlias ${LEGALTMVC_DEV_PUBLISH} ${LEGALTMVC_QA_PUBLISH} ${LEGALTMVC_STAGE_PUBLISH}  ${LEGALTMVC_DEV_PREVIEW} ${LEGALTMVC_QA_PREVIEW} ${LEGALTMVC_STAGE_PREVIEW} ${LEGALHVC_PROD_PREVIEW}
	
	DocumentRoot "${DOCROOT}"

	AllowEncodedSlashes On
	ErrorDocument 404 /content/legal/marriottvacationclubs/errors/404.html
	ErrorDocument 500 /content/legal/marriottvacationclubs/errors/404.html

	<IfModule mod_headers.c>
		Header add X-Vhost "LEGAL_TMVCS(marriottvacationclubs)"


        <LocationMatch "^/content/dam.*xml">
			Header unset Content-Disposition
			Header set Content-Disposition inline
		</LocationMatch>
		
		
		
		# Open robots.txt in new window
		<LocationMatch "^/content/dam.*txt">
			Header unset Content-Disposition
			Header set Content-Disposition inline
			ForceType "text/plain"
         	Header set Content-Type "text/plain"
		</LocationMatch>

		<Files "robots.txt">
           ForceType "text/plain"
           Header set Content-Type "text/plain"
        </Files>
		
		
		
		# Open PDF files in browser instead of forcing download.
		<LocationMatch "^/content/dam/legal/marriottvacationclubs/.*\.pdf$">
			Header unset Content-Disposition
			Header set Content-Disposition inline
			Header set Cache-Control "max-age=3600,stale-while-revalidate=3600" "expr=%{REQUEST_STATUS} < 400"
			Header set Surrogate-Control "max-age=7200,stale-while-revalidate=7200" "expr=%{REQUEST_STATUS} < 400"

			Header set Surrogate-Key "LegaL_TMVCS_Documents" "expr=%{REQUEST_STATUS} < 400"

		</LocationMatch>


        # Disallow disptacher caching for html pages
        <LocationMatch "^/content/legal/marriottvacationclubs/.*\.(html)$">
            Header always unset Expires
            Header set Cache-Control "max-age=300,stale-while-revalidate=300" "expr=%{REQUEST_STATUS} < 400"
            Header set Surrogate-Control "max-age=7200,stale-while-revalidate=7200,stale-if-error=10" "expr=%{REQUEST_STATUS} < 400"
			Header set Surrogate-Key "LegaL_TMVCS_Pages" "expr=%{REQUEST_STATUS} < 400"

          # Header set Cache-Control "no-cache, no-store, must-revalidate"
          # Header set Pragma "no-cache"
          # Header set Expires "0"
           # Header set Age 0
        </LocationMatch>


        # Disallow caching for the specific HTML file
        <LocationMatch ".*\.nocache\..*">
            Header set Cache-Control "no-cache, no-store, must-revalidate"
            Header set Pragma "no-cache"
            Header set Expires "0"
            # Header set Age 0
        </LocationMatch>



        # Cache-control for scripts and stylesheets, 30 days
        <LocationMatch "^/etc\.clientlibs/.*\.(css|js)$">
             Header set Cache-Control "max-age=2592000,stale-while-revalidate=3600" "expr=%{REQUEST_STATUS} < 400"
           #  Header set Surrogate-Control "stale-while-revalidate=3600,stale-if-error=3600" "expr=%{REQUEST_STATUS} < 400"
           # Header set Cache-Control "no-cache, no-store, must-revalidate"
           # Header set Pragma "no-cache"
           # Header set Expires "0"
            #  Header set Age 0
        </LocationMatch>

        # Cache-control for fonts, 30 days
        <LocationMatch "^/etc\.clientlibs/.*\.(otf|eot|ttf|woff|woff2)$">
            Header set Cache-Control "max-age=2592000,stale-while-revalidate=3600" "expr=%{REQUEST_STATUS} < 400"
        #    Header set Surrogate-Control "stale-while-revalidate=43200,stale-if-error=43200" "expr=%{REQUEST_STATUS} < 400"
            # Header set Age 0
        </LocationMatch>

        # Cache-control for dam assets, 1 day
        <LocationMatch "^/content/dam/legalwebpages/.*\.(jpg|jpeg|png|gif|zip|pdf|mp4|mov|svg|webp)$">
           Header set Cache-Control "max-age=86400,stale-while-revalidate=3600" "expr=%{REQUEST_STATUS} < 400"
         #  Header set Surrogate-Control "stale-while-revalidate=3600,stale-if-error=3600" "expr=%{REQUEST_STATUS} < 400"
           # Header set Age 0
        </LocationMatch>

		# Cache-control for dam assets, 1 day
        <LocationMatch "^/content/dam/legal/.*\.(jpg|jpeg|png|gif|zip|pdf|mp4|mov|svg|webp)$">
           Header set Cache-Control "max-age=86400,stale-while-revalidate=3600" "expr=%{REQUEST_STATUS} < 400"
         #  Header set Surrogate-Control "stale-while-revalidate=3600,stale-if-error=3600" "expr=%{REQUEST_STATUS} < 400"
           # Header set Age 0
        </LocationMatch>

	</IfModule>

	<Directory />
		<IfModule disp_apache2.c>
			ModMimeUsePathInfo On
			DirectorySlash Off
			SetHandler dispatcher-handler
			Header set X-Route "dispatcher"
		</IfModule>
		Options FollowSymLinks
		AllowOverride None
		SetOutputFilter DEFLATE
		SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png)$ no-gzip dont-vary
		Header always append X-Frame-Options SAMEORIGIN
	</Directory>

	<Directory "${DOCROOT}">
		Options FollowSymLinks Includes
		AddOutputFilter INCLUDES .html
		AllowOverride None
		Require all granted
		SetOutputFilter DEFLATE
		SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png)$ no-gzip dont-vary
		Header always append X-Frame-Options SAMEORIGIN
		SetEnvIf X-Forwarded-Proto "https" HTTPS=on
		Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
	</Directory>

	<IfModule disp_apache2.c>
		DispatcherUseProcessedURL On
		DispatcherPassError 1
	</IfModule>

	<IfModule mod_rewrite.c>
		RewriteEngine on
		Include conf.d/rewrites/legaltmvcs_rewrite.rules
	</IfModule>
</VirtualHost>
