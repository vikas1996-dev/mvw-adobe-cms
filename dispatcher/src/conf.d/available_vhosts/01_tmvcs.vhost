Include conf.d/variables/custom.vars

<VirtualHost *:80>
	ServerName ${TMVCS_WWW}
    ServerAlias ${TMVCS_WWW} ${TMVCS_DEV_PUBLISH} ${TMVCS_QA_PUBLISH} ${TMVCS_STAGE_PUBLISH} ${TMVCS_DEV_PREVIEW} ${TMVCS_QA_PREVIEW} ${TMVCS_STAGE_PREVIEW} ${TMVCS_PROD_PREVIEW}
	DocumentRoot "${DOCROOT}"

	AllowEncodedSlashes On

		ErrorDocument 404 /content/tmvcs/us/en/errors/404.html
		ErrorDocument 500 /content/tmvcs/us/en/errors/500.html
        ErrorDocument 503 /content/tmvcs/us/en/errors/503.html

	# Add header breadcrumbs for help in troubleshooting
	<IfModule mod_headers.c>
		Header add X-Vhost "tmvcs"

		<LocationMatch "^\/content\/dam.*xml">
			Header unset Content-Disposition
			Header set Content-Disposition inline
		</LocationMatch>

        # Open robots.txt in new window
		<LocationMatch "^\/content\/dam.*txt">
			Header unset Content-Disposition
			Header set Content-Disposition inline
            ForceType "text/plain"
            Header set Content-Type "text/plain"
		</LocationMatch>

        <Files "robots.txt">
         ForceType "text/plain"
         Header set Content-Type "text/plain"
        </Files>
 

        # Open DAM pdfs in preview mode
		<LocationMatch "^\/content\/dam.*pdf">
			Header unset Content-Disposition
			Header set Content-Disposition inline
		</LocationMatch>

        #view videos on page and not download

        <LocationMatch "^\/content\/dam.*.(mp4|webp).*">
			Header unset Content-Disposition
			Header set Content-Disposition inline
		</LocationMatch>

        # Add a dedicated surrogate key for destinations pages across locale paths     
        <LocationMatch "^/content/tmvcs/[^/]+/[^/]+/experiences/destinations(?:/.*)?\\.html$">
        Header set Cache-Control "max-age=300,stale-while-revalidate=300" "expr=%{REQUEST_STATUS} < 400"
           Header set Surrogate-Control "max-age=86400,stale-while-revalidate=86400,stale-if-error=10" "expr=%{REQUEST_STATUS} < 400"

            Header set Surrogate-Key "TMVCS_Destinations" "expr=%{REQUEST_STATUS} < 400"
        </LocationMatch>

        # Add a dedicated surrogate key for destinations pages across locale paths
        <LocationMatch "^/content/tmvcs/[^/]+/[^/]+/experiences/resorts(?:/.*)?\\.html$">
            Header set Cache-Control "max-age=300,stale-while-revalidate=300" "expr=%{REQUEST_STATUS} < 400"
           Header set Surrogate-Control "max-age=86400,stale-while-revalidate=86400,stale-if-error=10" "expr=%{REQUEST_STATUS} < 400"

            Header set Surrogate-Key "TMVCS_Resorts" "expr=%{REQUEST_STATUS} < 400"
        </LocationMatch>



        # Disallow disptacher caching for html pages
        <LocationMatch "^/content/tmvcs/.*\.(html)$">
            Header always unset Expires
            Header set Cache-Control "max-age=7200,stale-while-revalidate=7200" "expr=%{REQUEST_STATUS} < 400"
           Header set Surrogate-Control "max-age=86400,stale-while-revalidate=86400,stale-if-error=10" "expr=%{REQUEST_STATUS} < 400"
             Header set Surrogate-Key "TMVCS_Pages" "expr=%{REQUEST_STATUS} < 400 && %{REQUEST_URI} !~ m#^/(?:content/tmvcs/[^/]+/[^/]+/)?experiences/(destinations|resorts)(?:/.*)?\\.html$#"
          # Header set Cache-Control "no-cache, no-store, must-revalidate"
          # Header set Pragma "no-cache"
          # Header set Expires "0"
          # Header set Age 0
        </LocationMatch>


        # Disallow caching for the specific HTML file
        <LocationMatch ".*\.nocache\..*">
            Header set Cache-Control "no-cache, no-store, must-revalidate"
            Header set Pragma "no-cache"
            Header set Expires "0"
            # Header set Age 0
        </LocationMatch>

        # Cache-control for JSON responses on any path, 1 day
        <LocationMatch "^/(?:content/tmvcs/[^/]+/[^/]+/)?experiences/destinations/_jcr_content\\.data\\.json$">
            Header set Cache-Control "max-age=300,stale-while-revalidate=300" "expr=%{REQUEST_STATUS} < 400"
            Header set Surrogate-Control "max-age=86400,stale-while-revalidate=86400,stale-if-error=10" "expr=%{REQUEST_STATUS} < 400"
            Header set Surrogate-Key "TMVCS_Destinations_data" "expr=%{REQUEST_STATUS} < 400"
        </LocationMatch>

        <LocationMatch "^/(?:content/tmvcs/[^/]+/[^/]+/)?experiences/resorts/_jcr_content\\.data\\.json$">
            Header set Cache-Control "max-age=300,stale-while-revalidate=300" "expr=%{REQUEST_STATUS} < 400"
            Header set Surrogate-Control "max-age=86400,stale-while-revalidate=86400,stale-if-error=10" "expr=%{REQUEST_STATUS} < 400"
            Header set Surrogate-Key "TMVCS_Resorts_data" "expr=%{REQUEST_STATUS} < 400"
        </LocationMatch>

        <LocationMatch "^/(?:content/tmvcs/[^/]+/[^/]+/)?city-collection/_jcr_content\\.data\\.json$">
            Header set Cache-Control "max-age=300,stale-while-revalidate=300" "expr=%{REQUEST_STATUS} < 400"
            Header set Surrogate-Control "max-age=86400,stale-while-revalidate=600,stale-if-error=600" "expr=%{REQUEST_STATUS} < 400"
            Header set Surrogate-Key "TMVCS_Resorts_data" "expr=%{REQUEST_STATUS} < 400"
        </LocationMatch>

        <LocationMatch "^/.*\.(json)$">
            Header set Cache-Control "max-age=300,stale-while-revalidate=300" "expr=%{REQUEST_STATUS} < 400"
            Header set Surrogate-Key "TMVCS_Json" "expr=%{REQUEST_STATUS} < 400 && %{REQUEST_URI} !~ m#^/(?:content/tmvcs/[^/]+/[^/]+/)?(?:experiences/(destinations|resorts)|city-collection)/_jcr_content\\.data\\.json$#"
           # Header set Age 0
        </LocationMatch>



        # Cache-control for scripts and stylesheets, 30 days
        <LocationMatch "^/etc\.clientlibs/.*\.(css|js)$">
             Header set Cache-Control "max-age=2592000,stale-while-revalidate=3600" "expr=%{REQUEST_STATUS} < 400"
           #  Header set Surrogate-Control "stale-while-revalidate=3600,stale-if-error=3600" "expr=%{REQUEST_STATUS} < 400"
           # Header set Cache-Control "no-cache, no-store, must-revalidate"
           # Header set Pragma "no-cache"
           # Header set Expires "0"
            # Header set Age 0
        </LocationMatch>

        # Cache-control for fonts, 30 days
        <LocationMatch "^/etc\.clientlibs/.*\.(otf|eot|ttf|woff|woff2)$">
            Header set Cache-Control "max-age=2592000,stale-while-revalidate=3600" "expr=%{REQUEST_STATUS} < 400"
        #    Header set Surrogate-Control "stale-while-revalidate=43200,stale-if-error=43200" "expr=%{REQUEST_STATUS} < 400"
           # Header set Age 0
        </LocationMatch>

        # Cache-control for dam assets, 1 day
        <LocationMatch "^/content/dam/tmvcs/.*\.(jpg|jpeg|png|gif|zip|pdf|mp4|mov|svg|webp)$">
           Header set Cache-Control "max-age=86400,stale-while-revalidate=3600" "expr=%{REQUEST_STATUS} < 400"
           Header set Surrogate-Key "TMVCS_Assets" "expr=%{REQUEST_STATUS} < 400"
         #  Header set Surrogate-Control "stale-while-revalidate=3600,stale-if-error=3600" "expr=%{REQUEST_STATUS} < 400"
          # Header set Age 0
        </LocationMatch>


        Header set Access-Control-Allow-Origin "*"

	</IfModule>

     

    <Directory />
        <IfModule disp_apache2.c>
            # Some items cache with the wrong mime type
            # Use this option to use the name to auto-detect mime types when cached improperly
            ModMimeUsePathInfo On
            # Use this option to avoid cache poisioning
            # Sling will return /content/image.jpg as well as /content/image.jpg/ but apache can't search /content/image.jpg/ as a file
            # Apache will treat that like a directory.  This assures the last slash is never stored in cache
            DirectorySlash Off
            # Enable the dispatcher file handler for apache to fetch files from AEM
            SetHandler dispatcher-handler
            Header set X-Route "dispatcher"

        </IfModule>
        Options FollowSymLinks
        AllowOverride None
        # Insert filter
        SetOutputFilter DEFLATE
        # Don't compress images
        SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png)$ no-gzip dont-vary
        # Make sure proxies don't deliver the wrong content
        #Header append Vary User-Agent env=!dont-vary
        # Prevent clickjacking
        Header always append X-Frame-Options SAMEORIGIN
    </Directory>
	<Directory "${DOCROOT}">
	    # Add Includes to enable SSI Includes used by Sling Dynamic Include
		Options FollowSymLinks Includes

		# Set includes to process .html files
		AddOutputFilter INCLUDES .html
		AllowOverride None
		Require all granted

		# Insert filter
		SetOutputFilter DEFLATE

		# Don't compress images
		SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png)$ no-gzip dont-vary

		# Make sure proxies don't deliver the wrong content
		#Header append Vary User-Agent env=!dont-vary

		# Prevent clickjacking
		Header always append X-Frame-Options SAMEORIGIN

		# Enforce HTTPS
        SetEnvIf X-Forwarded-Proto "https" HTTPS=on
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

        
	</Directory>
    <IfModule disp_apache2.c>
        # Enabled to allow rewrites to take affect and not be ignored by the dispatcher module
        DispatcherUseProcessedURL	On
        # Serve configured Apache ErrorDocument for backend errors while keeping URL unchanged.
        DispatcherPassError		1
    </IfModule>
    <IfModule mod_rewrite.c>
        RewriteEngine on

        RewriteMap map301 dbm=sdbm:/tmp/rewrites/map301
        RewriteMap map302 dbm=sdbm:/tmp/rewrites/map302

        RewriteCond ${map301:%{REQUEST_URI}|NOT_FOUND} !NOT_FOUND
        RewriteRule ^ ${map301:%{REQUEST_URI}} [R=301,L]

        RewriteCond ${map302:%{REQUEST_URI}|NOT_FOUND} !NOT_FOUND
        RewriteRule ^ ${map302:%{REQUEST_URI}} [R=302,L]

        # Redirects
        Include conf.d/rewrites/tmvcs_rewrite.rules
    </IfModule>
</VirtualHost>
